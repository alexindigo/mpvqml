#!/usr/bin/env bash
set -euo pipefail

build=${1:-build-debug}
mode=${2:-}
[[ -z $mode || $mode == --coverage ]] || { echo "Usage: $0 [build] [--coverage]" >&2; exit 2; }

export QT_FORCE_STDERR_LOGGING=1
if [[ $mode == --coverage ]]; then
    lcov --directory "$build" --zerocounters
fi

env -u DISPLAY -u WAYLAND_DISPLAY -u WAYLAND_SOCKET -u QSG_RHI_BACKEND \
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    ctest --test-dir "$build" --no-tests=error -L '^headless$' --output-on-failure
env -u DISPLAY -u QT_QUICK_BACKEND QT_QPA_PLATFORM=wayland \
    LIBGL_ALWAYS_SOFTWARE=1 QSG_RHI_BACKEND=opengl \
    ctest --test-dir "$build" --no-tests=error -L '^(native|installed)$' --output-on-failure

if [[ $mode == --coverage ]]; then
    lcov --capture --directory "$build" --output-file "$build/coverage-raw.info" \
        --ignore-errors inconsistent,empty
    lcov --remove "$build/coverage-raw.info" '*_autogen*' '*/tests/*' '/usr/*' \
        --output-file "$build/coverage.info" --ignore-errors unused,inconsistent,empty
    genhtml "$build/coverage.info" --output-directory "$build/coverage-html"
fi
