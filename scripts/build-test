#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "$0")/.." && pwd)
build=${1:-build-debug}
mode=${2:-}
[[ -z $mode || $mode == --coverage ]] || { echo "Usage: $0 [build] [--coverage]" >&2; exit 2; }
coverage=OFF
if [[ $mode == --coverage ]]; then coverage=ON; fi

cmake -B "$build" -S "$repo" \
    -DCMAKE_BUILD_TYPE=Debug \
    -DBUILD_TEST_MODE=ON \
    -DENABLE_COVERAGE="$coverage"

# Compile the test binaries
cmake --build "$build"

# Run tests
"$repo/scripts/run-tests" "$build" "$mode"
